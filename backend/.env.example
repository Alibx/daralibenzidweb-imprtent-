# ==========================================
# دار علي بن زيد — Backend Environment Variables
# ==========================================

# Port the server listens on
PORT=8080

# Environment mode (development / production)
NODE_ENV=production

# Option 1: Full MySQL Database Connection URL (e.g. Railway, PlanetScale, Aiven, Render, Docker)
DATABASE_URL=mysql://root:password@localhost:3306/daralibenzid

# Option 2: Discrete MySQL Connection Parameters (Alternative)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=daralibenzid
